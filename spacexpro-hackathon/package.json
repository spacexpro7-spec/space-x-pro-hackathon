{
  "name": "spacexpro-hackathon",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run local/dev.ts",
    "start": "bun run local/dev.ts",
    "build": "bun run local/build.ts",
    "build:client": "bun ./client/build.mjs",
    "build:server": "bun build ./server/src/actions.ts --target=bun --outfile=./server/dist/actions.js",
    "typecheck": "bun run local/typecheck.ts"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:./local/space-sdk",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.0.15",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
